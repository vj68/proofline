# Use deterministic mode for the reproducible synthetic-data walkthrough.
PROOFLINE_AGENT_MODE=deterministic

# Or switch to "strands" after AWS credentials and Bedrock access are configured.
# PROOFLINE_AGENT_MODE=strands
AWS_PROFILE=your-profile
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# To make the web console invoke the deployed managed runtime instead:
# PROOFLINE_AGENT_MODE=agentcore
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT:runtime/NAME
